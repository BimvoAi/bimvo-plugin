{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    // No repositório, o kit fica ao lado. No servidor, o build resolve o kit dele (PAGE_KIT_DIR).
    "paths": { "@bigbang/page-kit/*": ["../page-kit/src/*"] }
  },
  "include": ["src"]
}
